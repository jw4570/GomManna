# Copy to .env on your own machine. Keep the real file out of Git.
# Use the Supabase session-pooler connection for the restricted server role.
# Percent-encode special characters in the password and certificate path.
GOMMANNA_DATABASE_URL=postgresql://SERVER_USER.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslrootcert=ENCODED_CERTIFICATE_PATH
GOMMANNA_HOST=127.0.0.1
GOMMANNA_PORT=8080
