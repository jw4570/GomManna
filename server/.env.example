# Supabase Connect → PostgreSQL connection string. 비밀번호의 특수문자는 URL 인코딩.
# 네트워크 환경에 따라 direct connection 또는 session pooler를 사용합니다.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=system
# openssl rand -hex 32 명령으로 생성. 재시작 후에도 같은 값을 유지하세요.
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HOST=127.0.0.1
PORT=8080
DB_POOL_SIZE=4
TOKEN_TTL_HOURS=720
ROOM_TTL_HOURS=24
